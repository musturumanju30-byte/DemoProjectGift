# Creative Paradise Gift Store — Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials

# Supabase Configuration (From https://supabase.com/dashboard/project/<your-project-id>/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google OAuth Setup Guide:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized Redirect URI:
#    https://<your-project-ref>.supabase.co/auth/v1/callback
# 4. Copy the Client ID & Secret from Google Cloud into:
#    Supabase Dashboard -> Authentication -> Providers -> Google
# 5. Enable the Google provider toggle in Supabase.
